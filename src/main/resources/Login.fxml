<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" nodeOrientation="LEFT_TO_RIGHT" prefHeight="357.0" prefWidth="408.0" spacing="15.0" style="-fx-background-color: linear-gradient(to bottom, #f8f8f8, #557a59); -fx-effect: dropshadow(gaussian, rgb(118, 135, 118), 10, 0.5, 0, 0); -fx-background-radius: 20;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="LoginController">
    <padding>
        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
    </padding>
    <HBox alignment="CENTER_RIGHT" prefHeight="32.0" prefWidth="95.0">
        <Button onAction="#handleClose" prefHeight="56.0" prefWidth="37.0" style="             -fx-background-color: linear-gradient(to bottom, #ff6b6b, #c9184a);             -fx-background-radius: 30;             -fx-cursor: hand;             -fx-font-size: 14px;             -fx-font-weight: bold;             -fx-border-radius: 30;             -fx-border-color: rgba(255,255,255,0.25);             -fx-border-width: 1;         " text="✕" textFill="WHITE" StackPane.alignment="TOP_RIGHT">

            <effect>
                <DropShadow color="#ffb3c1" radius="12" spread="0.2" />
            </effect>

            <font>
                <Font name="Segoe UI Symbol" size="14" />
            </font>

        </Button>
    </HBox>
    <Label alignment="CENTER_LEFT" prefHeight="21.0" prefWidth="228.0" style="-fx-font-size: 13px; -fx-font-weight:Bold;" text="Log in to your account" textAlignment="CENTER" textFill="#0b8b49">
        <font>
            <Font name="Arial Bold" size="13.0" />
        </font>
        <effect>
            <Glow />
        </effect></Label>

    <TextField fx:id="userNameField" maxWidth="220.0" promptText="Username">
        <font>
            <Font name="System Bold Italic" size="13.0" />
        </font></TextField>

    <PasswordField fx:id="passwordField" maxWidth="220.0" promptText="Password">
        <font>
            <Font name="System Bold Italic" size="13.0" />
        </font>
        <VBox.margin>
            <Insets />
        </VBox.margin></PasswordField>

    <Button fx:id="loginButton" cache="true" onAction="#handleLogin" prefHeight="23.0" prefWidth="121.0" style="-fx-background-color: #058837;" text="Login" textFill="WHITE">
        <font>
            <Font size="13.0" />
        </font>
        <effect>
            <Glow />
        </effect></Button>

    <Label fx:id="errorLabel" prefHeight="17.0" prefWidth="220.0" />
    <AmbientLight color="CHARTREUSE" lightOn="true" />
    <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true" />

</VBox>